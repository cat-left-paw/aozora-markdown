{
  "name": "aozora-markdown",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Convert Aozora Bunko texts into clean, reusable Markdown.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./encoding": {
      "types": "./dist/encoding/index.d.ts",
      "import": "./dist/encoding/index.js"
    },
    "./policies": {
      "types": "./dist/policies/index.d.ts",
      "import": "./dist/policies/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "import": "./dist/import/index.js"
    },
    "./browser": {
      "types": "./dist/adapters/browser/index.d.ts",
      "import": "./dist/adapters/browser/index.js"
    },
    "./import.worker.js": "./dist/adapters/browser/import.worker.js",
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./browser/export": {
      "types": "./dist/adapters/browser/export.d.ts",
      "import": "./dist/adapters/browser/export.js"
    },
    "./export.worker.js": "./dist/adapters/browser/export.worker.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.import.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.export.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.preview-worker.json",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.import.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.export.json",
    "test:browser": "node scripts/browser-smoke.mjs",
    "data:generate": "python3 scripts/generate_data.py && python3 scripts/generate_patterns.py",
    "data:check": "python3 scripts/generate_data.py --check && python3 scripts/generate_patterns.py --check",
    "reference:check": "python3 design/validate_design.py && python3 design/reference_oracle.py --check",
    "check": "npm test && npm run typecheck && npm run build && npm run test:browser",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/browser/*.mjs\" \"scripts/*.mjs\" \"*.json\" vitest.config.ts \"web/**/*.ts\" \"web/*.css\" \"web/*.html\"",
    "verify": "node scripts/verify.mjs",
    "test:import-browser": "node scripts/import-browser-smoke.mjs",
    "zip:check": "python3 scripts/generate_zip_fixtures.py --check && node scripts/zip-library-probe.mjs",
    "export:check": "node scripts/export-library-probe.mjs && node scripts/export-runtime-probe.mjs",
    "test:export-browser": "node scripts/export-browser-smoke.mjs",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "npm run build:web && node scripts/serve-web.mjs",
    "test:web": "node scripts/web-smoke.mjs",
    "compat:v3": "python3 scripts/specify_v3_delta.py --check && python3 design/validate_compatibility_v3.py",
    "test:s6-browser": "node scripts/s6-browser-smoke.mjs",
    "test:s7-browser": "node scripts/s7-browser-smoke.mjs",
    "test:s8-browser": "node scripts/s8-browser-smoke.mjs",
    "test:vp-browser": "node scripts/vp-browser-smoke.mjs",
    "test:fui-browser": "node scripts/fui-browser-smoke.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.17.0",
    "markdown-it": "15.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cat-left-paw/aozora-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/cat-left-paw/aozora-markdown/issues"
  }
}
